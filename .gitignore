# Node / Bun
node_modules/
jspm_packages/
.npm
.node_repl_history
*.tsbuildinfo
.eslintcache

# Bun
bun.lockb

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Env / secrets
.env
.env.*
!.env.example
!.env.test.example

# Runtime data
*.pid
*.seed

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# IDE
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code
**/.playwright-mcp/
_*.claude.md
.claude/_*.claude.md

# Sync tool runtime outputs (not committed — ephemeral per-user)
runs.jsonl
metrics.jsonl
.sync-defaults.json
.notion-cache.json
.notion-cache.*.json
.notion-image-cache.json
.notion-sync-state.json
.notion-sync-state.*.json
.notion-snapshots/
.notion-snapshots.*/
.notion-diff-cache.json
.notion-diff-cache.*.json
.notion-sync-progress.json
.notion-sync-progress.*.json
# .env.test handled by .env.* rule above; .env.test.example is the committed template
# Scratch artifacts from dev sessions (playwright screenshots, review reports)
*.png
/.claude/output/
# .claude — track skills/SKILL.md, ignore session/runtime state
/.claude/wal.jsonl
/.claude/wal.*
/.claude/scheduled_tasks.lock
/.claude/settings.local.json
/.claude/locks/
/.claude/_*.claude.md
/.claude/skills/runtime-notes.md
/.claude/skills/**/runtime-notes.md
/.claude/skills/**/_*.claude.md
