# ── Required ──────────────────────────────────────────────────────────────────

# Notion integration secret (from https://www.notion.so/my-integrations)
# Starts with "secret_..." or "ntn_..."
NOTION_TOKEN=

# ID or URL slug of the root Notion page where docs will be synced
# Example: My-Docs-34abacd27dee80f3be8fe230c7d1ff9d
NOTION_ROOT_PAGE_ID=

# ── Docs source ───────────────────────────────────────────────────────────────

# Absolute path to the local docs directory to sync
# Example: /Users/you/code/myproject/frontend/docs
DOCS_DIR=

# ── GitHub (for link fallbacks + image URLs) ───────────────────────────────────

# GitHub repo in "owner/repo" format
# Example: versable-git/enhancement-product
GITHUB_REPO=

# Branch for GitHub URLs (default: development)
GITHUB_BRANCH=development

# Repo-relative path that corresponds to DOCS_DIR root — used to build image URLs
# Example: if DOCS_DIR = .../frontend/docs, set this to frontend/docs
#
# IMAGES NOTE: image URLs are built as
#   https://raw.githubusercontent.com/${GITHUB_REPO}/${GITHUB_BRANCH}/${GITHUB_DOCS_ROOT}/<image-path>
# These work only if the repo is PUBLIC. Private repos return 404 to Notion
# (Notion doesn't authenticate to GitHub). For private repos, options are:
#   1. Make the repo public
#   2. Host images on a public CDN (S3 public bucket, Cloudinary, imgur, etc.)
#      and rewrite paths in your markdown to absolute https:// URLs
#   3. Wait for the "Image upload to Notion" feature (TODO #1) which uses the
#      Notion Files API to host images on Notion's CDN
GITHUB_DOCS_ROOT=frontend/docs

# Repo-relative path for markdown link fallbacks (GitHub viewer URLs)
# Example: frontend/docs
GITHUB_DOCS_PATH=frontend/docs

# Optional: explicit base URL for the per-doc "View source on GitHub" link
# in each page's breadcrumb. If unset, computed as
#   https://github.com/${GITHUB_REPO}/blob/${GITHUB_BRANCH}/${GITHUB_DOCS_ROOT}
# Set this if you want stable source-link URLs that don't track the sync branch
# (e.g. point them at `main` while you sync from `development`), or to use a
# self-hosted git host.
# Example: https://github.com/versable-git/enhancement-product/blob/main/frontend/docs
GITHUB_DOC_SOURCE_URL_BASE=

# ── Notion behaviour ──────────────────────────────────────────────────────────

# How to rewrite relative .md links between docs (default: notion)
#   notion  — rewrite to Notion page URL; fall back to GitHub URL if not found
#   github  — always rewrite to GitHub file URL
#   strip   — remove link, leave plain text
NOTION_LINK_MODE=notion

# Default emoji applied as icon to all leaf pages without frontmatter "icon:"
# Example: 📄
NOTION_PAGE_ICON=

# Default emoji for folder/section pages that have no _index.md
# Example: 📁
NOTION_FOLDER_ICON=

# Set to "0" to disable full-width layout on all pages (default: on)
NOTION_FULL_WIDTH=

# Set to "0" to suppress the frontmatter metadata banner at top of each page (default: on)
NOTION_SHOW_META=

# Path to a JSON file mapping top-level folder names to separate Notion root page IDs
# Format: { "product": "notion-page-id", "system": "other-notion-page-id" }
# Example: ./sync-map.json
NOTION_SYNC_MAP=

# ── Image upload to Notion CDN ─────────────────────────────────────────────────

# Set to "1" to upload every image referenced in markdown to Notion's CDN
# (via the v5 fileUploads API) and rewrite image blocks to use file_upload
# references instead of external GitHub raw URLs.
#
# REQUIRED for private GitHub repos — Notion can't authenticate to GitHub,
# so raw.githubusercontent.com URLs return 404 and images don't render.
#
# Cache: content-addressed by sha256 of file bytes, stored in
# .notion-image-cache.json (gitignored). Re-runs reuse uploads automatically;
# moved/renamed images with unchanged content also reuse. Edited images get
# a fresh upload (the old upload is orphaned but still counts as referenced
# until you implement a prune pass).
#
# Cost: ~2 API calls per new image (create + send), 0 calls per cached image.
# Default off — only opt in if your repo is private or you want Notion-hosted
# images for performance/portability reasons.
NOTION_UPLOAD_IMAGES=

# ── Run control ───────────────────────────────────────────────────────────────

# Set to "1" to preview without writing to Notion
DRY_RUN=
