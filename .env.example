# ── Required ──────────────────────────────────────────────────────────────────

# Notion integration secret (from https://www.notion.so/my-integrations)
# Starts with "secret_..." or "ntn_..."
NOTION_TOKEN=

# ID of the root Notion page where docs will be synced
# Copy from the page URL: https://www.notion.so/workspace/Page-Title-<PAGE_ID>
NOTION_ROOT_PAGE_ID=

# ── Optional ──────────────────────────────────────────────────────────────────

# GitHub repo in "owner/repo" format — used for link fallbacks when NOTION_LINK_MODE=github
# Example: versable-git/enhancement-product
GITHUB_REPO=

# Branch used in GitHub link fallbacks (default: development)
GITHUB_BRANCH=development

# Path to docs folder within the GitHub repo, used to build GitHub URLs
# Default: frontend/docs/product
GITHUB_DOCS_PATH=frontend/docs/product

# Path to the local docs directory to sync
# Can be absolute or relative to CWD. Default: ../../docs/product (relative to this script)
# Example: /Users/you/code/myproject/docs/product
DOCS_DIR=

# How to handle relative .md links between docs (default: notion)
#   notion  — rewrite to Notion page URL; fall back to GitHub URL
#   github  — always rewrite to GitHub file URL
#   strip   — remove link, leave plain text
NOTION_LINK_MODE=notion

# Default emoji applied as icon to all pages that don't have "icon:" in frontmatter
# Example: 📄
NOTION_PAGE_ICON=

# Set to 1 to do a dry run — shows what would be synced without writing to Notion
DRY_RUN=
