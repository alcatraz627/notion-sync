# .env.test — environment for the reconcile-flow test runner.
#
# Copy to .env.test and fill in:
#   1. NOTION_ROOT_PAGE_ID — a sandbox parent page in your workspace.
#      ⚠ DO NOT use your production root. Create a fresh page (e.g.
#        "🧪 Reconcile Sandbox") in Notion, share it with your integration,
#        and put its ID here.
#
# Everything else inherits sensible defaults for testing — strict guardrails,
# no image upload, mention conversion off (sample doc has no inter-page links).
#
# Loaded via: bash sync.sh --env .env.test ...
# Gitignored.

# ── Required ──────────────────────────────────────────────────────────────────

# Reuse the same token as production — the integration just needs access to
# the sandbox page in addition to its existing pages.
NOTION_TOKEN=

# Sandbox page ID. Copy the URL of a fresh test page in Notion; the trailing
# 32-hex slug is the ID. Example URL:
#   https://www.notion.so/Reconcile-Sandbox-abcdef0123456789abcdef0123456789
NOTION_ROOT_PAGE_ID=

# ── Test docs root ────────────────────────────────────────────────────────────

# Absolute path to the sandbox docs folder. Defaults to tests/reconcile/sandbox/
# in this repo — change only if you want to test against a different doc set.
DOCS_DIR=__SCRIPT_DIR__/tests/reconcile/sandbox

# ── Behaviour overrides ───────────────────────────────────────────────────────

# Strict guardrails — the whole point of the test.
NOTION_GUARDRAILS=strict

# Skip image upload (sample uses public URLs; no need for fileUploads).
NOTION_UPLOAD_IMAGES=0

# Skip mention conversion (sample has no inter-page links).
NOTION_USE_MENTIONS=0

# Frontmatter banner ON so the sample's status / audience / last_updated show.
NOTION_SHOW_META=1

# Link mode: notion (resolves .md links to Notion URLs where possible).
NOTION_LINK_MODE=notion

# Default page icon (overridden by sample.md frontmatter).
NOTION_PAGE_ICON=📄
